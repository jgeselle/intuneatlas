{
  "name": "intuneatlas",
  "version": "0.0.28",
  "description": "Flatten every Intune profile into one settings index, matched by the real setting — not just a shared name.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "intuneatlas": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:ui": "cd web && npm install && npm run build",
    "bundle": "node scripts/bundle.mjs",
    "package": "node scripts/bundle.mjs && node scripts/build-sea.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/msal-node": "^5.6.0",
    "@azure/msal-node-extensions": "^5.4.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.3.0",
    "open": "^11.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
