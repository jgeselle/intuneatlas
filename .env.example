# Interactive use (device code / interactive browser) generally only needs
# --tenant on the command line. These are for the unattended / hosted path
# (client-credentials flow), or to avoid retyping flags locally.

INTUNEATLAS_TENANT_ID=
INTUNEATLAS_CLIENT_ID=
# Only set for unattended/hosted use. Never commit a real value.
INTUNEATLAS_CLIENT_SECRET=
