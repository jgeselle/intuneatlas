{
  "description": "A Baseline-state entry whose value fails a numeric rule gets promoted to Below baseline with a recommendation attached.",
  "entries": [
    {
      "key": "Screen Lock Timeout::windows10",
      "name": "Screen Lock Timeout",
      "cspPath": "./Vendor/MSFT/Policy/Config/DeviceLock/DeviceLockTimeInSeconds",
      "category": "Device lock",
      "platform": "windows10",
      "values": ["1200"],
      "sources": [],
